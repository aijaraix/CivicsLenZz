{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "production:truth-audit": "tsx scripts/producer-internal-truth-audit.ts",
    "test": "tsx test/election-semantics-contract.test.ts && tsx test/hermes-bridge-contract.test.ts && tsx test/master-harvester-capability.test.ts && tsx test/zero-hardcoded-truth-and-no-fabricated-ids.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "d3-geo": "^3.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-router-dom": "^7.18.2",
    "react-simple-maps": "^3.0.0",
    "topojson-client": "^3.1.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react-simple-maps": "^3.0.6",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
